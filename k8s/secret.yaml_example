# Gmail MCP Server - Kubernetes Secret Template
#
# Fill in the values below, then apply with:
#   kubectl apply -f k8s/secret.yaml
#
# For credentials.json and token.json, paste the file contents inline (indented).
# For GEMINI_API_KEY, paste the raw key string.
#
apiVersion: v1
kind: Secret
metadata:
  name: gmail-mcp-secrets
  namespace: default
type: Opaque
stringData:
  GEMINI_API_KEY: "YOUR_GEMINI_API_KEY_HERE"

  # Required for Claude Code triage (or use Vertex AI env vars instead — see PODMAN.md)
  ANTHROPIC_API_KEY: "sk-ant-..."

  # Required for stable Flask sessions across pod restarts. Generate with:
  #   python3 -c 'import secrets; print(secrets.token_hex(32))'
  FLASK_SECRET_KEY: "YOUR_FLASK_SECRET_KEY_HERE"

  credentials.json: |
    {
      "YOUR": "credentials.json contents here"
    }

  token.json: |
    {
      "YOUR": "token.json contents here"
    }

  # Optional: leave empty string to disable PIN protection.
  # To enable, generate the salt:hash value with:
  #   make set-pin        # creates .pincode in repo root
  #   cat .pincode        # copy the "salt:hash" string below
  .pincode: ""
